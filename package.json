{
  "name": "mcp-test-server",
  "version": "1.0.0",
  "description": "Minimal MCP server for testing ChatGPT access to a local file",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "mcp-test-server": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --loader tsx dist/server.ts",
    "dev2": "tsx src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}